{
  // Cloudflare account that owns every Worker and provisioned resource.
  "accountId": "18503a03d3ee1fd75ac41f76c8d155b4",

  // The deployment's public origin, derived from workers.router.route.customDomain.
  "publicBaseUrl": null,

  // Worker names are permanent service identities. Keep them unique within the account.
  "workers": {
    // Owns the public URL and routes backend and Gatekeeper requests.
    "router": {
      "name": "cloudflareos",
      "route": { "customDomain": "cloudflareos.apphub.work" }
    },
    "workshop": { "name": "cloudflareos-backend" },
    "context": { "name": "cloudflareos-gk-context" },
    "scheduler": { "name": "cloudflareos-gk-scheduler" },
    "mcpGatekeeper": { "name": "cloudflareos-gk-mcp" },
    "githubGatekeeper": {
      "name": "cloudflareos-gk-github",
      "clientId": "Ov23lig6sVCZgMCAoCAQ"
    },
    "errorReporter": { "name": "cloudflareos-errors" }
  },

  "auth": {
    "mode": "github",
    "admins": ["lsjustin89@gmail.com"]
  },

  "aiGateway": { "enabled": false },

  "context": {
    "sharingDomain": null,
    "kvNamespaceId": "4247c13ddd7e430a8b74e552ea5c31a1"
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  "resources": {
    "blueprintsKvNamespaceId": "13ce55ef6770496692ffdb8a7e56dc32",
    "avatarsKvNamespaceId": "417d8def70e0441ba3304041fb7061b5",
    "blueprintContentBucket": "cloudflareos-blueprint-content"
  },

  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
