{
  // Production control surface for the pinned upgrade. This branch does not deploy.
  // Account: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "18503a03d3ee1fd75ac41f76c8d155b4",

  // Derived from workers.router.route.customDomain. null keeps Context scoped to that origin.
  "publicBaseUrl": null,

  // The seven production Workers: router, Workshop, Context, Scheduler, MCP, GitHub, Error Reporter.
  "workers": {
    "router": {
      "name": "cloudflareos",
      "route": { "customDomain": "cloudflareos.apphub.work" }
    },
    "workshop": { "name": "cloudflareos-backend" },
    "context": { "name": "cloudflareos-gk-context" },
    "scheduler": { "name": "cloudflareos-gk-scheduler" },
    "errorReporter": { "name": "cloudflareos-errors" }
  },

  // This deployment never had Web Search. Leave it out of the plan rather than naming an eighth Worker.
  "webSearch": { "enabled": false },

  // GitHub and the user-endpoint MCP Gatekeeper only. Google, PDF Renderer, Microsoft and
  // PagerDuty are left unselected. GitHub OAuth secrets stay on the Worker: record the names
  // CLIENT_ID and CLIENT_SECRET, never the values. Upstream classifies both as secrets.
  "gatekeepers": {
    "github": { "name": "cloudflareos-gk-github" },
    "mcp": { "name": "cloudflareos-gk-mcp" }
  },

  // GitHub is the only sign-in. Password login is off. Cloudflare Access stays unset.
  "auth": { "mode": "github" },
  "access": {
    "admins": ["lsjustin89@gmail.com"]
  },

  // Catalog off. The Workshop still gets the WORKERS_AI binding from the deploy.
  "aiGateway": { "enabled": false },

  "context": {
    "sharingDomain": null,
    "kvNamespaceId": "4247c13ddd7e430a8b74e552ea5c31a1"
  },

  // The old custom Gatekeeper Worker stays deleted.
  "customGatekeeper": { "enabled": false },

  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // Existing resources. null would ask Wrangler to provision empty ones.
  "resources": {
    "blueprintsKvNamespaceId": "13ce55ef6770496692ffdb8a7e56dc32",
    "avatarsKvNamespaceId": "417d8def70e0441ba3304041fb7061b5",
    "blueprintContentBucket": "cloudflareos-blueprint-content"
  },

  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
